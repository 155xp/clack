fn count_positive(values: int[4]) -> int:
    ensures 0 <= result and result <= len(values)

    i = 0
    count = 0
    while i < len(values):
        invariant 0 <= i and i <= len(values)
        invariant 0 <= count and count <= i
        decreases len(values) - i

        if values[i] > 0:
            count = count + 1
        i = i + 1
    return count

fn main():
    original = [3, -1, 0, 7]
    changed = original
    changed[1] = 2
    print(count_positive(original))
    print(count_positive(changed))
    print(original[1])
