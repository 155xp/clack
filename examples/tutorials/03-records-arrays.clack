type Point:
    x: int
    y: int

fn move_right(point: Point) -> Point:
    requires -1000000 <= point.x <= 1000000
    ensures result.x == point.x + 1
    ensures result.y == point.y
    return Point(point.x + 1, point.y)

fn main():
    original = Point(3, 4)
    moved = move_right(original)
    counts = [3, 0, 7, 2]
    updated = counts
    updated[1] = moved.x
    print(original.x)
    print(moved.x)
    print(counts[1])
    print(updated[1])
    print(len(counts))
