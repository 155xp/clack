fn count_to(n: int) -> int:
    requires 0 <= n <= 1000000
    ensures result == n
    total = 0
    for i in range(n):
        invariant total == i
        total = total + 1
    return total

fn main():
    values = [10, 20, 30]
    for i in range(len(values)):
        print(values[i])
    for i in range(3, 5):
        print(i)
    print(count_to(10))
