fn count_nonzero(values: int[4]) -> int:
    ensures 0 <= result <= len(values)
    i = 0
    count = 0
    while i < len(values):
        invariant 0 <= i <= len(values)
        invariant 0 <= count <= i
        decreases len(values) - i
        if values[i] != 0:
            count = count + 1
        i = i + 1
    return count

fn main():
    print(count_nonzero([5, 0, -2, 8]))
    print(count_nonzero([0, 0, 0, 0]))
