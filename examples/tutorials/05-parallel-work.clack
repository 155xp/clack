fn count_nonzero(values: int[4]) -> int:
    ensures 0 <= result <= len(values)
    i = 0
    count = 0
    while i < len(values):
        invariant 0 <= i <= len(values)
        invariant 0 <= count <= i
        decreases len(values) - i
        if values[i] != 0:
            count = count + 1
        i = i + 1
    return count

fn main():
    values = [5, 0, -2, 8]
    parallel:
        left = count_nonzero(values)
        right = count_nonzero([0, 1, 0, 2])
    values[0] = 0
    print(left)
    print(right)
    print(left + right)
    print(values[0])
