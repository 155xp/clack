# Fixed-size array helpers. Every addition is checked in evaluation order.
# Preconditions constrain cumulative sums, rather than each element.

fn sum2(values: int[2]) -> int:
    requires -9223372036854775808 <= values[0] + values[1] <= 9223372036854775807
    ensures result == values[0] + values[1]
    return values[0] + values[1]

fn sum3(values: int[3]) -> int:
    requires -9223372036854775808 <= values[0] + values[1] <= 9223372036854775807
    requires -9223372036854775808 <= values[0] + values[1] + values[2] <= 9223372036854775807
    ensures result == values[0] + values[1] + values[2]
    return values[0] + values[1] + values[2]

fn sum4(values: int[4]) -> int:
    requires -9223372036854775808 <= values[0] + values[1] <= 9223372036854775807
    requires -9223372036854775808 <= values[0] + values[1] + values[2] <= 9223372036854775807
    requires -9223372036854775808 <= values[0] + values[1] + values[2] + values[3] <= 9223372036854775807
    ensures result == values[0] + values[1] + values[2] + values[3]
    return values[0] + values[1] + values[2] + values[3]

fn sum8(values: int[8]) -> int:
    requires -9223372036854775808 <= values[0] + values[1] <= 9223372036854775807
    requires -9223372036854775808 <= values[0] + values[1] + values[2] <= 9223372036854775807
    requires -9223372036854775808 <= values[0] + values[1] + values[2] + values[3] <= 9223372036854775807
    requires -9223372036854775808 <= values[0] + values[1] + values[2] + values[3] + values[4] <= 9223372036854775807
    requires -9223372036854775808 <= values[0] + values[1] + values[2] + values[3] + values[4] + values[5] <= 9223372036854775807
    requires -9223372036854775808 <= values[0] + values[1] + values[2] + values[3] + values[4] + values[5] + values[6] <= 9223372036854775807
    requires -9223372036854775808 <= values[0] + values[1] + values[2] + values[3] + values[4] + values[5] + values[6] + values[7] <= 9223372036854775807
    ensures result == values[0] + values[1] + values[2] + values[3] + values[4] + values[5] + values[6] + values[7]
    return values[0] + values[1] + values[2] + values[3] + values[4] + values[5] + values[6] + values[7]

fn all4(values: bool[4]) -> bool:
    ensures result == (values[0] and values[1] and values[2] and values[3])
    return values[0] and values[1] and values[2] and values[3]

fn any4(values: bool[4]) -> bool:
    ensures result == (values[0] or values[1] or values[2] or values[3])
    return values[0] or values[1] or values[2] or values[3]
